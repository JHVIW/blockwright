"""{title} -- {style} build, scaffolded by `python -m blockwright new {slug}`.

Program (replace with the real brief):
  - one main room with a door, windows and a light
  - a small garden at the entrance

Run (from the workspace folder):
    python builds/{slug}.py --quick        # fast: 3 views + contact sheet, QA, materials
    python builds/{slug}.py                # full: every view (iso x4, elevations, top, floor cutaways, eye level)

Outputs land in out/schematics, out/previews/{slug}, out/reports, out/materials.
Read the docs first: design/LESSONS.md, styles/{style}.md, API.md (`python -m blockwright where` prints the folder).

This starter is deliberately plain: a working, QA-clean box to replace.  Work massing -> roof -> materials and
contrast -> details, interior, landscaping, and LOOK at the renders after every step.
"""
import sys

from blockwright import *

b = Build("{slug}", "{title}", ground=0, description="{title}")
{palette_line}
frame_wood, roof_wood = wood("spruce"), wood("dark_oak")
FOUNDATION = "cobblestone"
WALL = "white_terracotta"
SEED = 1

# --- 1. massing: walls x 0..8, z 0..6 (9 x 7 footprint), floor in the ground layer (y=0) ----------------------
X0, X1, Z0, Z1, TOP = 0, 8, 0, 6, 3
b.fill(X0, 0, Z0, X1, 0, Z1, FOUNDATION)
b.fill(X0 + 1, 0, Z0 + 1, X1 - 1, 0, Z1 - 1, frame_wood.planks)          # floor
for y in range(1, TOP + 1):
    for x in range(X0, X1 + 1):
        for z in range(Z0, Z1 + 1):
            if x in (X0, X1) or z in (Z0, Z1):
                corner = x in (X0, X1) and z in (Z0, Z1)
                b.set(x, y, z, frame_wood.log("y") if corner else WALL)

# --- 2. roof: 45 degree gable along x with a 1-block overhang and a slab ridge ----------------------------------
k = 0
while True:
    y, zn, zs = TOP + 1 + k, Z0 - 1 + k, Z1 + 1 - k
    if zn > zs:
        break
    for x in range(X0 - 1, X1 + 2):
        if zn == zs:
            b.set(x, y, zn, roof_wood.slab("bottom"))
        else:
            b.set(x, y, zn, roof_wood.stairs("south"))
            b.set(x, y, zs, roof_wood.stairs("north"))
    for z in range(zn + 1, zs):                                            # close the gables
        for x in (X0, X1):
            b.set(x, y, z, frame_wood.planks)
    k += 1

# --- 3. openings: door on the south facade, windows on every side ----------------------------------------------
front = b.frame((4, 1, Z1), "south")
front.door(0, 0, 0, "spruce", facing="in", hinge="left")
front.entrance(0, 0, 1)
for x in (2, 6):
    b.set(x, 2, Z1, pane())
    b.set(x, 2, Z0, pane())
for z in (3,):
    b.set(X0, 2, z, pane())
    b.set(X1, 2, z, pane())

# --- 4. interior: light it so nothing can spawn, mark the room for QA ------------------------------------------
b.fill(X0, TOP + 1, 3, X1, TOP + 1, 3, frame_wood.stripped_log("x"))     # tie beam, gable wall to gable wall
b.set(4, TOP, 3, lantern(hanging=True))                                  # hangs from the beam
b.set(1, 1, 1, "crafting_table")
b.set(2, 1, 1, chest("south"))
b.room("main", 4, 1, 3)

# --- 5. landscaping: author only what you want; unset cells keep the natural terrain ---------------------------
b.line((4, 0, Z1 + 1), (4, 0, Z1 + 4), "dirt_path")
for i, x in enumerate((2, 3, 5, 6)):
    b.set(x, 0, Z1 + 1, "grass_block")
    b.set(x, 1, Z1 + 1, pick(["cornflower", "allium", "oxeye_daisy", "poppy"], x, 1, Z1 + 1, seed=SEED))

if __name__ == "__main__":
    b.finish()
